---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing - Franklin Ikeh" description="Things I've written about software engineering and building things.">
    <div class="space-y-10">
        <a href="/" class="block mb-8 text-sm text-gray-400 dark:text-gray-500">&lt;- Home</a>
        <h1 class="text-xl tracking-tight md:text-2xl">Things I've written</h1>

        <div class="space-y-8">
            {
                posts.length === 0 ? (
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Nothing here yet — check back later.
                    </p>
                ) : (
                    posts.map((post) => (
                        <div class="space-y-1">
                            <div class="flex items-start justify-between gap-4">
                                <a href={`/writing/${post.id}`}>
                                    {post.data.title}
                                </a>
                                <span class="shrink-0 text-sm text-gray-400 dark:text-gray-500">
                                    {post.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                        },
                                    )}
                                </span>
                            </div>
                        </div>
                    ))
                )
            }
        </div>
    </div>
</BaseLayout>
