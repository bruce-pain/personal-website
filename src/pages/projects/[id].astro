---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.name} - Franklin Ikeh`} description={project.data.description}>
    <a href="/projects" class="block mb-8 text-sm text-gray-400 dark:text-gray-500">&lt;- Back</a>
    <article class="space-y-8">
        <div class="space-y-3">
            <h1 class="text-2xl font-medium tracking-tight md:text-3xl">
                {project.data.name}
            </h1>
            <div
                class="flex flex-col items-start gap-2 text-sm text-gray-400 dark:text-gray-500"
            >
                <div class="flex gap-2 text-gray-500 dark:text-gray-400">
                    Status:
                    {project.data.wip && <span>[WIP]</span>}
                    {project.data.live && <span>[Live]</span>}
                </div>
                <span>
                    {
                        project.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </span>
            </div>
            <p
                class="text-base leading-relaxed text-gray-600 dark:text-gray-400"
            >
                {project.data.description}
            </p>
        </div>

        <div class="prose dark:prose-invert">
            <Content />
        </div>
    </article>

    <a href="#" class="block mt-8 text-sm text-gray-400 dark:text-gray-500">^ Top</a>
</BaseLayout>
