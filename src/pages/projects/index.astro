---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects - Franklin Ikeh">
    <div class="space-y-10">
        <a href="/" class="block mb-8 text-sm text-gray-400 dark:text-gray-500">&lt;- Home</a>
        <h1 class="text-xl tracking-tight md:text-2xl">Things I've built</h1>

        <div class="space-y-8">
            {
                projects.length === 0 ? (
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Nothing here yet — check back later.
                    </p>
                ) : (
                    projects.map((project) => (
                        <div class="space-y-1">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex flex-wrap items-baseline gap-x-2">
                                    <a
                                        href={`/projects/${project.id}`}
                                        class="font-medium no-underline hover:underline"
                                    >
                                        {project.data.name}
                                    </a>
                                </div>
                                <span class="shrink-0 text-sm text-gray-400 dark:text-gray-500">
                                    {project.data.date.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                        },
                                    )}
                                </span>
                            </div>
                            <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                                {project.data.description}
                            </p>
                        </div>
                    ))
                )
            }
        </div>
    </div>
</BaseLayout>
